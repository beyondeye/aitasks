{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/guard_live_tmux.py",
            "timeout": 10,
            "statusMessage": "Checking tmux socket safety"
          }
        ]
      }
    ]
  }
}
