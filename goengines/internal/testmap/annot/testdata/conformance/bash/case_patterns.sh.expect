lang: bash
expect: certain
read:
  - line=7 member= key=covers value=src/in_case.sh stamp= origin=comment
writable: 7
readonly: 
lookalikes: 
comments: 7
refuse: none
native: bash-n+shfmt+bash-exec
exec: bash {file}
note: case patterns with ')' and a quoted '#' pattern; the comment inside the case arm is a real comment
