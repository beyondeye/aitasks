lang: bash
expect: certain
read:
  - line=4 member= key=kind value=unit stamp= origin=comment
  - line=5 member= key=covers value=src/lib/a.sh stamp=@2026-01-02/0123456789 origin=comment
  - line=8 member=Alpha key=unit value=Alpha stamp= origin=comment
  - line=9 member=Alpha key=covers value=src/lib/alpha.sh stamp= origin=comment
writable: 4-5,8-9
readonly: 
lookalikes: 
comments: 2-5,8-9,15
refuse: none
placement: file=5 member:Alpha=9
native: bash-n+shfmt+bash-exec
exec: bash {file}
