lang: python
expect: certain
read:
  - line=2 member= key=covers value=src/p.sh stamp= origin=docstring
  - line=5 member= key=covers value=src/comment.sh stamp= origin=comment
writable: 5
readonly: 2
lookalikes: 
comments: 5
refuse: none
placement: file=5
native: python-tokenize+ast
note: the literal ends on line 3, the statement on line 4; the file-level block already has line 5
