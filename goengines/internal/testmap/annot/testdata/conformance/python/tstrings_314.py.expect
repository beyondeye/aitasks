lang: python
expect: certain
read:
  - line=7 member= key=covers value=src/real.py stamp= origin=comment
  - line=13 member= key=covers value=src/real2.py stamp= origin=comment
writable: 7,13
readonly: 
lookalikes: 3,5,11
comments: 7,13
refuse: none
native: python-tokenize+ast+python-exec
exec: python3 {file}
note: t1954_4: Python 3.14 t-strings: quotes reused inside a field, a comment inside a multi-line field (line 5: a real tokenize COMMENT that M2.2's policy never treats as an annotation line), a raw t-string
x-policy: 5
