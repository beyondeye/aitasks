lang: python
expect: certain
read:
  - line=2 member= key=covers value=src/crlf_doc.py stamp= origin=docstring
  - line=4 member= key=covers value=src/crlf.py stamp= origin=comment
writable: 4
readonly: 2
lookalikes: 
comments: 4
refuse: none
native: python-tokenize+ast+python-exec
exec: python3 {file}
