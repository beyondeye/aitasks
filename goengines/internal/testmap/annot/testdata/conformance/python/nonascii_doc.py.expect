lang: python
expect: certain
read:
  - line=4 member= key=covers value=src/doc_x.py stamp= origin=docstring
  - line=6 member= key=covers value=src/a.py stamp= origin=comment
writable: 6
readonly: 4
lookalikes: 
comments: 1,6
refuse: none
placement: file=6
native: python-tokenize+ast+python-exec
exec: python3 {file}
note: t1954_3: the docstring's content bounds and statement end follow non-ASCII bytes
