lang: python
expect: certain
read:
  - line=3 member= key=covers value=src/bom_doc.py stamp= origin=docstring
writable: 
readonly: 3
lookalikes: 
comments: 
refuse: none
placement: file=4
native: python-tokenize+ast+python-exec
exec: python3 {file}
note: Python skips a UTF-8 BOM, so line 1 opens the module docstring
