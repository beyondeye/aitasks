lang: python
expect: certain
read:
  - line=3 member= key=covers value=src/doc_src.py stamp=@2026-01-02/0123456789 origin=docstring
  - line=5 member= key=kind value=unit stamp= origin=comment
  - line=6 member= key=covers value=src/a.py stamp= origin=comment
  - line=10 member=TestA key=unit value=TestA stamp= origin=comment
  - line=11 member=TestA key=covers value=src/a.py stamp= origin=comment
writable: 5-6,10-11
readonly: 3
lookalikes: 14
comments: 5-6,10-11
refuse: none
placement: file=6 member:TestA=11
native: python-tokenize+ast+python-exec
exec: python3 {file}
note: several blocks cover src/a.py (file-level line 6, TestA line 11)
