lang: python
expect: certain
read:
  - line=5 member= key=covers value=src/real.py stamp= origin=comment
writable: 5
readonly: 
lookalikes: 3
comments: 5
refuse: none
native: python-tokenize+ast+python-exec
exec: python3 {file}
note: PEP 750 template string (Python 3.14): an unknown prefix to older lexers
