lang: go
expect: certain
read:
  - line=6 member= key=covers value=internal/real.go stamp= origin=comment
  - line=9 member=TestNonAscii key=unit value=TestNonAscii stamp= origin=comment
  - line=10 member=TestNonAscii key=covers value=internal/member.go stamp= origin=comment
writable: 6,9-10
readonly: 
lookalikes: 11,14,16
comments: 1,6,8-10
refuse: none
placement: file=6 member:TestNonAscii=10
native: go-scanner+gofmt+go-run
exec: go run {file}
note: t1954_3 non-ASCII positions: 2-, 3- and 4-byte characters before every comment, look-alike and edit target
