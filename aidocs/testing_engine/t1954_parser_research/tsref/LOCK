#
# The Swift repository commits no generated parser at this commit: its
# src/parser.c is generated from src/grammar.json with exactly this CLI.
generator tree-sitter 0.26.9
generate tree-sitter-swift
#
# grammar <lang> <repo> <src dir>  (the dir holding parser.c [+ scanner.c])
grammar bash tree-sitter-bash src
grammar python tree-sitter-python src
grammar go tree-sitter-go src
grammar kotlin tree-sitter-kotlin src
grammar typescript tree-sitter-typescript typescript/src
grammar tsx tree-sitter-typescript tsx/src
grammar javascript tree-sitter-javascript src
grammar java tree-sitter-java src
grammar rust tree-sitter-rust src
grammar swift tree-sitter-swift src
