lang: bash
expect: certain
read:
  - line=4 member= key=covers value=src/real.sh stamp= origin=comment
  - line=8 member=NonAscii key=unit value=NonAscii stamp= origin=comment
  - line=9 member=NonAscii key=covers value=src/member.sh stamp= origin=comment
writable: 4,8-9
readonly: 
lookalikes: 3,11
comments: 2,4,7-9
refuse: none
placement: file=4 member:NonAscii=9
native: bash-n+shfmt+bash-exec
exec: bash {file}
note: t1954_3 non-ASCII positions: 2-, 3- and 4-byte characters before every comment, look-alike and edit target
