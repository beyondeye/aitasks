lang: bash
expect: certain
read:
  - line=2 member= key=covers value=src/shared.sh stamp=@2026-01-01/0123456789 origin=comment
  - line=4 member=A key=unit value=A stamp= origin=comment
  - line=5 member=A key=covers value=src/shared.sh stamp=@2026-01-01/0123456789 origin=comment
  - line=7 member=B key=unit value=B stamp= origin=comment
  - line=8 member=B key=covers value=src/shared.sh stamp=@2026-01-01/0123456789 origin=comment
  - line=9 member=B key=covers value=src/b.sh stamp= origin=comment
writable: 2,4-5,7-9
readonly: 
lookalikes: 12
comments: 2,4-5,7-9
refuse: none
placement: file=2 member:A=5 member:B=9
native: bash-n+shfmt+bash-exec
exec: bash {file}
note: several blocks cover src/shared.sh: re-stamping B's must leave the file-level and A's lines record- and byte-identical
