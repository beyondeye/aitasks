lang: bash
expect: certain
read:
  - line=2 member= key=covers value=src/embed.sh stamp= origin=comment
  - line=16 member= key=covers value=src/embed2.sh stamp= origin=comment
writable: 2,16
readonly: 
lookalikes: 4,8,12-13
comments: 2,16
refuse: none
native: bash-n+shfmt+bash-exec
exec: bash {file}
note: embedded languages: a python heredoc, an awk program in single quotes, SQL in a double-quoted string
