lang: bash
expect: certain
read:
  - line=7 member= key=covers value=src/arith.sh stamp= origin=comment
writable: 7
readonly: 
lookalikes: 
comments: 7
refuse: none
native: bash-n+shfmt+bash-exec
exec: bash {file}
note: a heredoc inside a command substitution inside $(( … )): valid bash (exec prints 2)
