lang: bash
expect: certain
read:
  - line=2 member= key=covers value=src/heredoc.sh stamp= origin=comment
  - line=24 member= key=covers value=src/real2.sh stamp= origin=comment
writable: 2,24
readonly: 
lookalikes: 5,10,14,17,22
comments: 2,24
refuse: none
placement: file=24
native: bash-n+shfmt+bash-exec
exec: bash {file}
note: delimiter-shaped arguments (EOF as a printf argument, grep pattern), a heredoc delayed by a backslash continuation, <<- with tabs, nested $( … $( … ) … ) with a heredoc, a partly quoted delimiter
