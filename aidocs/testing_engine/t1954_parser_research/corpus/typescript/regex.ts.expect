lang: typescript
expect: certain
read:
  - line=5 member= key=covers value=src/after_regex.ts stamp= origin=comment
  - line=7 member= key=covers value=src/real.ts stamp= origin=comment
writable: 5,7
readonly: 
lookalikes: 1,3,8
comments: 5,7
refuse: none
native: node-ts+node-exec
exec: node {file}
note: regex literals containing // and /* (a context-free scanner opens a block comment at r3's '/*')
