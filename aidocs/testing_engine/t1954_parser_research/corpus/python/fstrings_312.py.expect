lang: python
expect: certain
read:
  - line=9 member= key=covers value=src/real.py stamp= origin=comment
writable: 9
readonly: 
lookalikes: 6,8
comments: 9
refuse: none
native: python-tokenize+ast+python-exec
exec: python3 {file}
note: PEP 701 f-strings: reused quotes, a comment inside a multi-line replacement field (line 4 starts inside the f-string: neither writable nor a look-alike), a token look-alike in the literal part
