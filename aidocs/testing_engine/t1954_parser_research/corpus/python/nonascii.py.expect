lang: python
expect: certain
read:
  - line=3 member= key=covers value=src/real.py stamp= origin=comment
  - line=7 member=TestNonAscii key=unit value=TestNonAscii stamp= origin=comment
  - line=8 member=TestNonAscii key=covers value=src/member.py stamp= origin=comment
writable: 3,7-8
readonly: 
lookalikes: 2,10
comments: 1,3,6-8
refuse: none
placement: file=3 member:TestNonAscii=8
native: python-tokenize+ast+python-exec
exec: python3 {file}
note: t1954_3 non-ASCII positions: 2-, 3- and 4-byte characters before every comment, look-alike and edit target
