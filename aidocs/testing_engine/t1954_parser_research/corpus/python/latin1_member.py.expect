lang: python
expect: certain
read:
  - line=4 member= key=covers value=src/latin1_file.py stamp= origin=comment
  - line=6 member=TestLatin1 key=unit value=TestLatin1 stamp= origin=comment
  - line=7 member=TestLatin1 key=covers value=src/latin1_member.py stamp= origin=comment
writable: 4,6-7
readonly: 
lookalikes: 3
comments: 1-2,4,6-7
refuse: none
placement: file=4 member:TestLatin1=7
native: python-tokenize+ast+python-exec
exec: python3 {file}
note: t1954_3: one byte per non-ASCII character under a PEP 263 Latin-1 cookie; a UTF-8 decoder must refuse, never guess
