{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.aitask-scripts/aitask_session_hook.sh",
            "timeout": 10,
            "statusMessage": "Recording agent session"
          }
        ]
      }
    ]
  }
}
